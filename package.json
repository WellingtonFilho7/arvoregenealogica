{
  "name": "arvore-genealogica",
  "version": "1.0.0",
  "description": "Plataforma de Exploracao Genealogica com API Read-Only",
  "private": true,
  "dependencies": {
    "better-sqlite3": "^11.9.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.6.0",
    "@types/supertest": "^6.0.3",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "concurrently": "^9.1.2",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.4",
    "tsx": "^4.20.6",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "start": "concurrently -k \"npm run start:api\" \"npm run start:web\"",
    "start:api": "tsx server/index.ts",
    "start:web": "react-scripts start",
    "build": "react-scripts build",
    "test": "npm run typecheck:server && npm run test:server && npm run test:client",
    "test:client": "react-scripts test --watchAll=false",
    "test:server": "jest --config jest.server.config.cjs --runInBand",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint src --ext .js,.jsx"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
